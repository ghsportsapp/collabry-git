modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
META_APP_ID = "2523975474701175"
META_REDIRECT_URI = "https://fdaf2023-10a2-442e-a44f-c9c4a89570d9-00-fdq5cgsg6urz.sisko.replit.dev/api/auth/meta/callback"
FRONTEND_URL = "https://fdaf2023-10a2-442e-a44f-c9c4a89570d9-00-fdq5cgsg6urz.sisko.replit.dev"
INSTAGRAM_REDIRECT_URI = "https://fdaf2023-10a2-442e-a44f-c9c4a89570d9-00-fdq5cgsg6urz.sisko.replit.dev/api/auth/instagram/callback"

