# ─────────────────────────────────────────────────────────────
#  Collabry frontend — TEMPLATE
#  Copy to `.env` and fill in. Never commit a real .env.
# ─────────────────────────────────────────────────────────────

# ── Vite / runtime ───────────────────────────────────────────
NODE_ENV=production
PORT=5173
BASE_PATH=/

# ── Database (Prisma — seed + tooling only, NOT bundled) ─────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/collabry

# ── Admin bootstrap ──────────────────────────────────────────
ADMIN_EMAIL=admin@collabry.co

# ── Firebase Cloud Messaging (web push) ──────────────────────
# Firebase Console → Project Settings → General → "Your apps" → Web app config.
# VAPID key: Project Settings → Cloud Messaging → "Web Push certificates".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
