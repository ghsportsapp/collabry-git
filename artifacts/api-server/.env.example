# ─────────────────────────────────────────────────────────────
#  Collabry API server — TEMPLATE
#  Copy to `.env` and fill in. Never commit a real .env.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Used in email "Open Collabry" buttons + OAuth redirects.
APP_BASE_URL=https://collabry.co

# ── Database (Postgres) ──────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/collabry

# ── JWT secrets ──────────────────────────────────────────────
# Generate fresh values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=

# ── Object storage (Linode Object Storage — S3-compatible) ───
# Get keys at: Linode Cloud Manager → Object Storage → Access Keys.
# Public vs private separation is per-object — same bucket name for both.
# Region must match the datacenter where you created the bucket
# (in-maa-1 = Chennai, us-east-1 = Newark, ap-south-1 = Singapore, etc).
S3_REGION=in-maa-1
S3_ENDPOINT=https://in-maa-1.linodeobjects.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=collabry
S3_PRIVATE_BUCKET=collabry
S3_PUBLIC_BASE_URL=https://collabry.in-maa-1.linodeobjects.com

# ── Brevo SMTP (email + admin OTPs) ──────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=no-reply@collabry.co

# ── Firebase Admin (push notifications) ──────────────────────
# Single-line JSON. Firebase Console → Project Settings → Service Accounts → "Generate new private key".
FIREBASE_SERVICE_ACCOUNT=

# ── Meta / Instagram OAuth ───────────────────────────────────
# META_REDIRECT_URI must match Facebook Login → Settings → "Valid OAuth Redirect URIs".
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.collabry.co/api/auth/meta/callback

# ── Razorpay (DEFERRED) ──────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
